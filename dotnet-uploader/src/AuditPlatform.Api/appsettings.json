{
  "Platform": {
    "ApplicationName": "AuditPlatform",
    "DatabaseCapacityLimitBytes": 500000000
  },
  "Postgres": {
    "Enabled": false,
    "ConnectionString": "",
    "MaximumPoolSize": 10,
    "ConnectionTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 30,
    "ReadinessTimeoutSeconds": 3
  },
  "LogPersistence": {
    "DiagnosticTimeoutSeconds": 2,
    "MetadataMaxBytes": 5000,
    "MetadataMaxDepth": 8,
    "AuditDetailsMaxCharacters": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
