{
  "permissions": {
    "allow": ["Bash", "Edit", "Write"],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r -f:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)"
    ],
    "defaultMode": "default"
  }
}
