# ============================================================
# Copy this file to .env and fill in your real Supabase project's values.
# .env itself is never committed to git (see .gitignore) - this file is the
# committed, safe-to-share template documenting what's needed.
# ============================================================

# Supabase (Postgres) connection string - Supabase Dashboard > Project
# Settings > Database > Connection string.
#
# Prefer the POOLER connection (port 6543, "Transaction" mode) over the
# direct connection (port 5432) - Supabase's free tier caps direct
# connections low, and the pooler is what a Render free-tier deployment
# (Phase 7) should point at:
#   postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
#
# Direct connection form (works locally, not recommended once deployed):
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Optional: this app's own psycopg2 connection pool size (separate from
# Supabase's own pooler above - both can coexist). Defaults: 1 / 10.
# PG_POOL_MIN=1
# PG_POOL_MAX=10
