# ============================================================
# Copy this file to .env and fill in your real Supabase project's values.
# .env itself is never committed to git (see .gitignore) - this file is the
# committed, safe-to-share template documenting what's needed.
# ============================================================

# Supabase (Postgres) connection string - Supabase Dashboard > Project
# Settings > Database > Connection string.
#
# Prefer the POOLER connection (port 6543, "Transaction" mode) over the
# direct connection (port 5432) - Supabase's free tier caps direct
# connections low, and the pooler is what a Render free-tier deployment
# (Phase 7) should point at:
#   postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
#
# Direct connection form (works locally, not recommended once deployed):
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Optional: this app's own psycopg2 connection pool size (separate from
# Supabase's own pooler above - both can coexist). MIN = connections opened
# eagerly at startup; MAX = ceiling. Defaults: 3 / 15.
# PG_POOL_MIN=3
# PG_POOL_MAX=15
# Upload staging files default to the app's uploads/ directory. Set an absolute,
# persistent path if the server can run from different working folders.
# UPLOAD_STAGING_DIR=D:/Excel Auto/Upload Staging

# Verified archives for changed/deleted upload records. Set these in the running
# app environment; Codex's connected Drive account does not configure the server.
# Obtain a Google OAuth refresh token with Drive file access and access to the
# chosen folder. A folder selected/created through that OAuth app must be writable.
# Keep real secrets in .env locally or deployment environment settings.
# External OAuth apps in Testing receive seven-day refresh tokens. Complete
# production branding/publishing and authorize again before long-term use.
# DRIVE_CLIENT_ID=
# DRIVE_CLIENT_SECRET=
# DRIVE_REFRESH_TOKEN=
# DRIVE_ARCHIVE_FOLDER_ID=
# Protected second copy: an absolute directory OUTSIDE this application checkout.
# Local paths and private .env settings do not configure the hosted server.
# UPLOAD_ARCHIVE_DIR=D:/Audit Archives
# The administrator's app-wide switch controls every upload, including API clients.
# Backup on requires Drive verification; backup off skips both ZIP and Drive copies.
# This does not change the separate full-database backup Drive workflow.
# Administrator control: Administration > Settings > Upload backups.
# Untick "Back up replaced data to Google Drive" for development; tick for
# commercial use. Saved in the shared database, effective for all users.
# Former UPLOAD_ARCHIVE_TO_DRIVE/DEVELOPMENT_ALLOW_UNBACKED_UPLOADS flags are ignored.
# Render Free automatically uses temporary scratch space when UPLOAD_ARCHIVE_DIR
# is unset; only its verified Drive copy survives a restart. Local copies remain
# in UPLOAD_ARCHIVE_DIR. The validation Excel report is generated in the browser.
# Backup-on failures block replacement; development backup-off retains no archive.
# New-only imports and unchanged files do not require an archive transfer.

# Manual full PostgreSQL backups: local Windows application + administrator only.
# Default is disabled; never enable this on Render. Reuses UPLOAD_ARCHIVE_DIR and
# the app Drive settings above. Each dated copy is stored under full-database-backups.
LOCAL_DATABASE_BACKUP_ENABLED=false
# Folder containing matching official pg_dump.exe and pg_restore.exe; PATH is
# used only when this setting is absent. No tools are downloaded by the app.
# DATABASE_BACKUP_BIN_DIR=C:/path/to/PostgreSQL/bin
# Optional dedicated direct/session-mode connection (port 5432). Otherwise uses
# DATABASE_URL; Supabase transaction-mode port 6543 is rejected for this action.
# This URL stays private in .env. It is never passed in process arguments/logs.
# DATABASE_BACKUP_URL=postgresql://user:password@host:5432/postgres?sslmode=require
# The dump includes DB schemas/data/sequences; source Excel files, Storage object
# bytes, server-global roles and environment credentials need separate protection.
# No automatic restore, schedule or retention deletion is provided.
# Full snapshots require an unshared My Drive folder/file. ZIPs have no added
# password encryption; protect the archive disk/folder and Google account access.

# ============================================================
# Render deployment (Phase 7 of 8) - this .env file is LOCAL ONLY, never
# committed and never present on Render. In production, DATABASE_URL above
# is set as a Render environment variable instead (same pooler connection
# string) - entered via the Blueprint setup prompt or the Render dashboard,
# not a file. python-dotenv's load_dotenv() is a harmless no-op there since
# no .env file exists on the server. PORT is also env-injected by Render
# itself (not user-set) - main.py reads it with a local fallback of 5000.
# See render.yaml at the repo root for the full service definition.
# ============================================================
